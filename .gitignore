utils/ground_truth_check.py
tests/test_ground_truth_check.py
scripts/diagnostics/compare_to_ground_truth.py
scripts/diagnostics/validate_fig3_hazard.py

# Example files (tracked despite the blanket rules above)
!data/examples/
!data/examples/*.csv
