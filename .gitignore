__pycache__/
*.pyc
*.pyo
.DS_Store

.venv/
.envrc
.claude
.codex

# Large/regeneratable data and outputs -- see README.md
data/*
outputs/
*.csv
*.csv.gz
*.pkl

# ignore scoping markdown files (they're for local viewing only)
scoping*.md

# Ground-truth comparison tooling: maintainer-only, never shipped to external validators.
